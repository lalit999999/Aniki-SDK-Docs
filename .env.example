# Admin panel — off by default. The panel writes to the repo's own
# content/ tree, so it is intended for local + self-hosted authoring,
# not for read-only serverless production filesystems.
ANIKI_ADMIN_ENABLED=false
ANIKI_ADMIN_USERNAME=admin
ANIKI_ADMIN_PASSWORD_HASH=
ANIKI_ADMIN_SESSION_SECRET=
ANIKI_ADMIN_SESSION_TTL_SECONDS=43200

# Analytics (Prompt C)
ANIKI_ANALYTICS_DIR=.aniki-analytics

# Existing
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ANIKI_CONTENT_DIR=
